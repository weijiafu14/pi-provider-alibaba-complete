{
  "name": "pi-provider-alibaba-complete",
  "version": "1.0.0",
  "description": "Alibaba Cloud provider for Pi with Coding Plan, Token Plan, pay-as-you-go, dynamic catalogs, and verified reasoning controls",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-provider",
    "alibaba",
    "qwen",
    "dashscope",
    "reasoning",
    "deepseek"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run verify"
  },
  "license": "MIT",
  "author": "dinhe",
  "contributors": [
    "weijiafu14"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weijiafu14/pi-provider-alibaba-complete.git"
  },
  "homepage": "https://github.com/weijiafu14/pi-provider-alibaba-complete#readme",
  "bugs": {
    "url": "https://github.com/weijiafu14/pi-provider-alibaba-complete/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
